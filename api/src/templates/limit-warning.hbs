<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>
<body style="margin: 0; padding: 0; background-color: #141425; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif; -webkit-font-smoothing: antialiased;">
	<table width="100%" cellpadding="0" cellspacing="0" style="background-color: #141425; padding: 32px 0;">
		<tr>
			<td align="center">
				<table width="600" cellpadding="0" cellspacing="0" style="max-width: 600px; width: 100%;">
					<tr>
						<td align="center" style="padding: 32px 0 24px;">
							<img src="https://files.nexata.app/logo.png" alt="Nexata" style="height: 40px;" />
						</td>
					</tr>
					{{#if logoUrl}}
					<tr>
						<td align="center" style="padding: 0 0 16px;">
							<img src="{{logoUrl}}" alt="{{tenantDisplayName}}" style="max-height: 48px; max-width: 200px;" />
						</td>
					</tr>
					{{/if}}
					<tr>
						<td style="background-color: #252540; border-radius: 12px; padding: 32px; border: 1px solid rgba(255,255,255,0.1);">
							<h2 style="margin: 0 0 4px; color: #f9f9fc; font-size: 20px; font-weight: 600;">{{t.greeting}}</h2>
							<p style="color: #9e9eb5; font-size: 15px; line-height: 1.6; margin: 12px 0 0;">{{t.body}}</p>

							<table width="100%" cellpadding="0" cellspacing="0" style="background-color: rgba(255,255,255,0.05); border-radius: 8px; margin: 20px 0; border: 1px solid rgba(255,255,255,0.08);">
								<tr>
									<td style="padding: 16px;">
										<table width="100%" cellpadding="0" cellspacing="0">
											<tr>
												<td style="padding-bottom: 8px; border-bottom: 1px solid rgba(255,255,255,0.08);">
													<table width="100%" cellpadding="0" cellspacing="0">
														<tr>
															<td style="color: #9e9eb5; font-size: 12px; font-weight: 600; text-transform: uppercase; padding: 4px 0;"></td>
															<td width="80" style="color: #9e9eb5; font-size: 12px; font-weight: 600; text-transform: uppercase; padding: 4px 0; text-align: right;">{{t.usedLabel}}</td>
															<td width="80" style="color: #9e9eb5; font-size: 12px; font-weight: 600; text-transform: uppercase; padding: 4px 0; text-align: right;">{{t.limitLabel}}</td>
														</tr>
													</table>
												</td>
											</tr>
											{{#each limits}}
											<tr>
												<td style="padding: 8px 0;{{#unless @last}} border-bottom: 1px solid rgba(255,255,255,0.05);{{/unless}}">
													<table width="100%" cellpadding="0" cellspacing="0">
														<tr>
															<td style="color: #f9f9fc; font-size: 14px; padding: 2px 0;">{{this.label}}</td>
															<td width="80" style="color: #e8a838; font-size: 14px; font-weight: 600; padding: 2px 0; text-align: right;">{{this.used}}</td>
															<td width="80" style="color: #9e9eb5; font-size: 14px; padding: 2px 0; text-align: right;">{{this.limit}}</td>
														</tr>
													</table>
													<table width="100%" cellpadding="0" cellspacing="0" style="margin-top: 6px;">
														<tr>
															<td style="background-color: rgba(255,255,255,0.08); border-radius: 4px; height: 6px;">
																<div style="background-color: #e8a838; border-radius: 4px; height: 6px; width: {{this.percentage}}%;"></div>
															</td>
														</tr>
													</table>
												</td>
											</tr>
											{{/each}}
										</table>
									</td>
								</tr>
							</table>

							<div style="text-align: center; margin: 32px 0;">
								<a href="{{redirect}}" style="display: inline-block; background-color: #2db4c8; color: #1f1f1f; padding: 12px 32px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 14px;">
									{{t.buttonText}}
								</a>
							</div>

							<p style="color: #9e9eb5; font-size: 13px; margin: 0;">{{t.closing}}</p>
						</td>
					</tr>
					<tr>
						<td align="center" style="padding: 24px 0 0;">
							<p style="color: #9e9eb5; font-size: 13px; margin: 0;">&mdash; {{t.teamSignature}}</p>
						</td>
					</tr>
				</table>
			</td>
		</tr>
	</table>
</body>
</html>
