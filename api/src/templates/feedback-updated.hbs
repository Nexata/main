<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>
<body style="margin: 0; padding: 0; background-color: #141425; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif; -webkit-font-smoothing: antialiased;">
	<table width="100%" cellpadding="0" cellspacing="0" style="background-color: #141425; padding: 32px 0;">
		<tr>
			<td align="center">
				<table width="600" cellpadding="0" cellspacing="0" style="max-width: 600px; width: 100%;">
					<tr>
						<td align="center" style="padding: 32px 0 24px;">
							<img src="https://files.nexata.app/logo.png" alt="Nexata" style="height: 40px;" />
						</td>
					</tr>
					{{#if logoUrl}}
					<tr>
						<td align="center" style="padding: 0 0 16px;">
							<img src="{{logoUrl}}" alt="Organization" style="max-height: 48px; max-width: 200px;" />
						</td>
					</tr>
					{{/if}}
					<tr>
						<td style="background-color: #252540; border-radius: 12px; padding: 32px; border: 1px solid rgba(255,255,255,0.1);">
							<table cellpadding="0" cellspacing="0" style="margin-bottom: 4px;">
								<tr>
									{{#if pfpUrl}}
									<td style="vertical-align: middle; padding-right: 10px;">
										<img src="{{pfpUrl}}" alt="" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover;" />
									</td>
									{{/if}}
								<td style="vertical-align: middle;">
									<h2 style="margin: 0; color: #f9f9fc; font-size: 20px; font-weight: 600;">{{t.greeting}}</h2>
								</td>
								</tr>
							</table>
							<p style="color: #9e9eb5; font-size: 15px; line-height: 1.6; margin: 12px 0 0;">{{t.body}}</p>

							<table width="100%" cellpadding="0" cellspacing="0" style="background-color: rgba(255,255,255,0.05); border-radius: 8px; margin: 16px 0; border: 1px solid rgba(255,255,255,0.08);">
								<tr>
									<td style="padding: 16px;">
										<p style="margin: 0 0 8px; color: #f9f9fc; font-size: 14px;"><strong>{{t.statusLabel}}:</strong> <span style="color: #9e9eb5;">{{lookup t statusKey}}</span></p>
										<p style="margin: 0; color: #f9f9fc; font-size: 14px;"><strong>{{t.originalCommentLabel}}:</strong> <span style="color: #9e9eb5;">{{comment}}</span></p>
									</td>
								</tr>
							</table>

							{{#if response}}
							<table width="100%" cellpadding="0" cellspacing="0" style="background-color: {{#if isSolved}}rgba(45,180,200,0.1){{else}}rgba(255,255,255,0.05){{/if}}; border-radius: 8px; margin: 16px 0; border: 1px solid {{#if isSolved}}rgba(45,180,200,0.2){{else}}rgba(255,255,255,0.08){{/if}};">
								<tr>
									<td style="padding: 16px;">
										<p style="margin: 0 0 8px; color: #f9f9fc; font-size: 14px;"><strong>{{t.responseLabel}}:</strong></p>
										<p style="margin: 0; color: #9e9eb5; font-size: 14px;">{{response}}</p>
									</td>
								</tr>
							</table>
							{{/if}}

							<p style="color: #9e9eb5; font-size: 14px; margin: 16px 0 0;">{{t.closing}}</p>
						</td>
					</tr>
					<tr>
						<td align="center" style="padding: 24px 0 0;">
							<p style="color: #9e9eb5; font-size: 13px; margin: 0;">&mdash; {{t.teamSignature}}</p>
						</td>
					</tr>
				</table>
			</td>
		</tr>
	</table>
</body>
</html>
