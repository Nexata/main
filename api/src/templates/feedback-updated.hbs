<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; color: #333;">
	<div style="text-align: center; margin-bottom: 24px;">
		<img src="https://files.nexata.app/logo.png" alt="Nexata" style="height: 32px;" />
	</div>

	{{#if logoUrl}}
	<div style="text-align: center; margin-bottom: 16px;">
		<img src="{{logoUrl}}" alt="Organization" style="max-height: 48px; max-width: 200px;" />
	</div>
	{{/if}}

	<div style="margin-bottom: 4px; display: flex; align-items: center; gap: 10px;">
		{{#if pfpUrl}}
		<img src="{{pfpUrl}}" alt="" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover;" />
		{{/if}}
		<h2 style="margin: 0;">{{t.greeting}}, {{displayName}}</h2>
	</div>
	<p>{{t.body}}</p>

	<div style="background: #f5f5f5; padding: 16px; border-radius: 8px; margin: 16px 0;">
		<p style="margin: 0 0 8px;"><strong>{{t.statusLabel}}:</strong> {{lookup t statusKey}}</p>
		<p style="margin: 0;"><strong>{{t.originalCommentLabel}}:</strong> {{comment}}</p>
	</div>

	{{#if response}}
	<div style="background: {{#if isSolved}}#e8f4e8{{else}}#f5f5f5{{/if}}; padding: 16px; border-radius: 8px; margin: 16px 0;">
		<p style="margin: 0 0 8px;"><strong>{{t.responseLabel}}:</strong></p>
		<p style="margin: 0;">{{response}}</p>
	</div>
	{{/if}}

	<p>{{t.closing}}</p>
	<p style="color: #888;">&mdash; {{t.teamSignature}}</p>
</body>
</html>
