      "definition": "select \"credential\".\"id\", \"user\".\"id\" as \"user_id\", case when \"user\".\"is_admin\" = true then 'tenant-admin' when (\"credential\".\"user_id\" = \"user\".\"id\" or \"credential_permission\".\"is_admin\" = true) then 'admin' when \"credential_permission\".\"is_admin\" = false then 'read' else 'global' end as \"access_level\", \"owner\".\"id\" as \"owner_id\", \"owner\".\"email\" as \"owner_email\", \"credential\".\"provider\", \"credential\".\"scope\", \"credential\".\"email\", \"credential\".\"is_global\", \"credential\".\"access_token\", \"credential\".\"refresh_token\", \"credential\".\"access_token_expires_at\", \"credential\".\"created_at\" from \"credential\" inner join \"user\" \"owner\" on \"owner\".\"id\" = \"credential\".\"user_id\" inner join \"user\" on \"user\".\"slug\" = \"owner\".\"slug\" left join \"credential_permission\" on (\"credential_permission\".\"credential_id\" = \"credential\".\"id\" and \"credential_permission\".\"user_id\" = \"user\".\"id\") where (\"user\".\"is_admin\" = true or \"credential\".\"user_id\" = \"user\".\"id\" or \"credential_permission\".\"user_id\" is not null or \"credential\".\"is_global\" = true)",
      "name": "credential_access",
